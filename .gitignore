__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.env

data/pdfs/*.pdf
data/dashboard.db
data/flagged/

# Outlook snapshots hold real mailbox and calendar contents - never commit them.
data/inbox_snapshot.json
data/calendar_snapshot.json
data/shared_inbox_snapshot.json

# Saved meeting preps hold real counterparty analysis - never commit them.
data/preps/

# Decks uploaded for a meeting prep, kept so the note taker can show them
# again during the meeting - never commit them.
data/prep_decks/

# Local Notion snapshot holds real workspace records - never commit it.
data/notion_cache.json

# Shared web-research dossiers name real counterparties - never commit them.
data/research/

# Front-end build artefacts
web/node_modules/
web/dist/

# Playwright output — traces/screenshots from local runs, and the browser
# binaries it downloads. Neither belongs in the repo.
web/test-results/
web/playwright-report/
web/blob-report/

.DS_Store
data/questions/
data/managers/

# Live-meeting autosaves and the transcript library hold real meeting audio
# transcripts - never commit them.
data/live_sessions/
data/transcripts/

# Felix's change log and record snapshots hold real workspace content - never
# commit them (and undo depends on the snapshots staying put).
data/felix/

reload-test.*
