# Copy to .env and fill in. Loaded via python-dotenv where the app is started
# (e.g. `python -m dotenv run -- streamlit run dashboard/Home.py`), or export
# these directly in your shell / hosting platform's env config.
#
# Everything here is optional: each connector falls back to sample data when its
# credentials are absent, so the app always runs.

# --- Which billing rail the AI calls run on -------------------------------- #
# claude_cli (default) - the Claude Code CLI, i.e. YOUR CLAUDE ACCOUNT (whatever
#                        `claude login` established). No API key needed.
#                        Requires Claude Code installed and logged in on the
#                        machine running the app, so it suits local use rather
#                        than unattended hosting.
# api                  - anthropic.Anthropic(), billed to ANTHROPIC_API_KEY below.
#
# The two are separate billing rails: an API key cannot be used to spend a Claude
# subscription, and vice versa. Failures are never silently switched between them.
LLM_BACKEND=claude_cli

# Only used when LLM_BACKEND=claude_cli
# CLAUDE_CLI_PATH=claude
# CLAUDE_CLI_TIMEOUT=300
# CLAUDE_CLI_SCRATCH_DIR=

# --- Anthropic API (only needed when LLM_BACKEND=api) ---------------------- #
ANTHROPIC_API_KEY=

# --- Notion (self-serve; no admin needed) ---------------------------------- #
# Create an internal integration at https://www.notion.so/profile/integrations,
# then share the four databases with it. Database IDs are the 32-character
# strings in each database's URL.
NOTION_TOKEN=
NOTION_FUNDS_DB=
NOTION_COMPANIES_DB=
NOTION_CONTACTS_DB=
NOTION_NOTES_DB=

# --- Outlook / Microsoft 365 ----------------------------------------------- #
# ONLY needed for the standalone app to reach Outlook unattended. Requires an
# Entra ID (Azure AD) app registration with Mail.Read, Mail.ReadWrite and
# Calendars.Read - which usually needs tenant-admin consent.
#
# Without these the app reads data/inbox_snapshot.json and
# data/calendar_snapshot.json if present (written via Claude's Microsoft 365
# connector - see scripts/refresh_outlook_snapshot.py), and otherwise uses
# sample data.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_USER=

# --- Inbox triage scope ---------------------------------------------------- #
# Triage reads the top-level Inbox only (mail filed into a subfolder counts as
# dealt with), Focused and Other, for a rolling window of this many days.
# Both are adjustable per scan in the UI.
# TRIAGE_LOOKBACK_DAYS=3
# TRIAGE_MAX_MESSAGES=25

# --- Optional overrides (defaults shown) ----------------------------------- #
# PDF_FOLDER=./data/pdfs
# DB_PATH=./data/dashboard.db
# CLAUDE_VISION_MODEL=claude-opus-4-8
# CLAUDE_EXTRACTION_MODEL=claude-opus-4-8
# CLAUDE_REASONING_MODEL=claude-opus-4-8
